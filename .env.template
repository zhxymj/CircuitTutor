# CircuitTutor 环境变量模板
# 复制为 .env 并填入真实值；docker-compose 会自动读取 .env

# ---- 服务监听 ----
LSQC_HOST=0.0.0.0
LSQC_PORT=8765

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR
LSQC_LOG_LEVEL=INFO
# JSON 日志写入文件（留空则只输出到 stdout）
LSQC_LOG_FILE=

# ---- LLM ----
# DeepSeek API Key（不填则自动使用内置教学模板，不报错）
DEEPSEEK_API_KEY=
# 可选：自定义 API 端点
DEEPSEEK_BASE_URL=
# 模型名（默认 deepseek-flash）
DEEPSEEK_MODEL=

# ---- 限流 ----
# LLM 端点（/api/generate、/api/clarify）每 IP 每分钟配额；0=关闭
LSQC_RATE_LIMIT=30
# KiCad 导出端点每 IP 每分钟配额；0=关闭
LSQC_KICAD_RATE_LIMIT=20

# ---- 超时 ----
# LLM 单次调用超时（秒）
LSQC_LLM_TIMEOUT_S=60
# kicad-cli 子进程超时（秒）
KICAD_CLI_TIMEOUT_S=90

# ---- 查询限制 ----
MAX_QUERY_LEN=500
